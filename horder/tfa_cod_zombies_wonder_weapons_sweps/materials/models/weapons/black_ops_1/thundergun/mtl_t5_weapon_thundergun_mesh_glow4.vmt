"UnlitGeneric"
{
	$baseTexture "models\weapons\black_ops_1\thundergun\thunder_chamber_scroll_base"
	$detail "models\weapons\black_ops_1\thundergun\thunder_chamber_scroll_multiply"
	$detailblendmode 8
	$detailscale 1
		
	"$translate" "[0 0]"
	"$rotate" "90"
	"$center" "[0.5 0.5]"
	
	"Proxies"
	{
		"Sine"
		{
			sineperiod	3
			sinemin		0.2
			sinemax		0.33
			"resultVar" "$translate[0]"
		}
		
		"TextureTransform"
		{
			"translateVar" "$translate"
			"rotateVar" "$rotate"
			"centerVar" "$center"
			"resultVar" "$detailtexturetransform"
		}
	}
}