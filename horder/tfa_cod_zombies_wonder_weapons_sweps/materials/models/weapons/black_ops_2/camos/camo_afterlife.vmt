"VertexlitGeneric"
{
	"$basetexture" "models/weapons/black_ops_2/camos/camo_ritual_col"
	"$bumpmap" "models/weapons/black_ops_2/camos/camo_ritual_n"
	
	"$selfillum" "1"
	"$selfillumtint" "[0 0.6 1]"
	
	$EmissiveBlendEnabled 		"1"					// Enable EmissiveBlend. Like $selfillum 1	
	$EmissiveBlendStrength 		"1" 				// how strong the entire glow effect is.
	$EmissiveBlendTexture 		"vgui/white"
	$EmissiveBlendBaseTexture 	"models/weapons/black_ops_2/camos/camo_ritual_e"	// this is the glowing texture.vtf
	$EmissiveBlendFlowTexture 	vgui/white	 		// EmmisiveBlend can "flow" or move. But ours is static, so a white texture is used.
	$EmissiveBlendTint 			"[0 1.0 2]"		// RGB glow intensity. Leave at 1 1 1. This can be used to change how strong each color should glow.
	$EmissiveBlendScrollVector 	"[0 0]" 		// makes the EmmissiveBlend flow in either direction if a proper EmissiveBlendFlowTexture were set. But ours is static, so leave at 0 0
	
	"$phong" 	"1"
	"$phongexponent" 	"16"
	"$phongboost"	 "1"
	"$phongfresnelranges" "[0.25 0.75 1]"
	"$normalmapalphaphongmask" "1"
}