"VertexlitGeneric"
{
	"$basetexture" "models/weapons/black_ops_2/slipgun/zmb_slipgun_scroll"
	
	"$translate" "[0 0]"
	"$center" "[0.5 0.5]"
	
	"Proxies"
	{
		"LinearRamp"
		{
		"rate" 0.1
		"initialValue" 0.0
		"resultVar" "$translate[0]"
		}

		"TextureTransform"
		{
		"translateVar" "$translate"
		"centerVar" "$center"
		"resultVar" "$basetexturetransform"
		}
	}
}
