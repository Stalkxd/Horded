Refract
{
	$normalmap	"particles/custom/bo3/flat_warp_gradient"
	$normalmap2	"particles/custom/bo3/tfwater001_normal"
	$additive			1
	$vertexalpha		1
	$vertexcolor		1

 	$refractamount		4.0
	$bumpframe		0
	$bumpframe2		0

 	$bluramount		2
	$vertexcolormodulate	1

	$nocull			1

	Proxies
	{
		AnimatedTexture
		{
			"animatedtexturevar"		"$normalmap2"
			"animatedtextureframenumvar"	"$bumpframe2"
			"animatedtextureframerate"		144
		}
	}
}