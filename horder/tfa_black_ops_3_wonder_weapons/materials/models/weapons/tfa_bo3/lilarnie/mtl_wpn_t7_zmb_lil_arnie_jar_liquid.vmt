"VertexLitGeneric"
{
	$basetexture			"models/weapons/tfa_bo3/lilarnie/glass_e"
	$bumpmap				"models/weapons/tfa_bo3/lilarnie/ripples_n"
	$phongexponenttexture	"vgui/white"
	$additive "1"

	$detail	"models/weapons/tfa_bo3/lilarnie/bubbles_e"
	$detailblendmode "5"
	$detailscale "1"
	
	$phong	"1"
	$phongboost	"1"
	$phongfresnelranges	"[.78 .9 1]"
	$phongexponent "33"
	
	$envmap	"env_cubemap"
	$envmaptint	"[.2 .25 .18]"
	$normalmapalphaenvmapmask	"1"
	$envmapfresnel	"1"
	
	$emissiveblendenabled		"1"
	$emissiveblendstrength		"1"
	$emissiveblendtexture		"vgui/white"
	$emissiveblendbasetexture	"models/weapons/tfa_bo3/lilarnie/glass_e"
	$emissiveblendflowtexture	"vgui/white"
	$emissiveblendtint			"[0.1 1 0.7]"
	$emissiveblendscrollvector	"[0 0 0]"
	
	"Proxies"
	{
		"TextureScroll"
		{
			"textureScrollVar" "$detailtexturetransform"
			"textureScrollRate" "0.2"
			"textureScrollAngle" "90"
		}
	} 
}