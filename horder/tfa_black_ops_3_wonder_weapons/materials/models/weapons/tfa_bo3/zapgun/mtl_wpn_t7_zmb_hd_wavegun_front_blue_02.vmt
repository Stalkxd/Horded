"VertexLitGeneric"
{
	$basetexture			"models/weapons/tfa_bo3/zapgun/i_wpn_t7_zmb_hd_wavegun_front_weapon_d"
	$bumpmap				"models/weapons/tfa_bo3/zapgun/i_wpn_t7_zmb_hd_wavegun_front_weapon_n"
	$phongexponenttexture	"models/weapons/tfa_bo3/zapgun/i_wpn_t7_zmb_hd_wavegun_front_weapon_s"
	
	$detail					"models/weapons/tfa_bo3/zapgun/i_wpn_t7_zmb_hd_qed_blue_d"
	$detailscale "[2 2]"
	$detailblendmode "5"
	$detailblendfactor "1"

	$phong	"1"
	$phongboost	"5"
	$phongfresnelranges	"[.78 .9 1]"

	$envmap	"env_cubemap"
	$envmaptint	"[.25 .25 .25]"
	$normalmapalphaenvmapmask	"1"
	$envmapfresnel	"1"

	$translate "[0 0]"
	$rotate "90"

	Proxies
	{
		LinearRamp
		{
			rate "-0.5"
			initialvalue "0"
			resultvar "$translate[1]"
		}
		TextureTransform
		{
			rotateVar "$rotate"
			translatevar "$translate"
			resultvar "$detailtexturetransform"
		}
	}
}