"VertexLitGeneric"
{
	$basetexture			"models/weapons/tfa_bo3/wunderwaffe/i_wpn_t7_zmb_dg2_pipe_d"
	$bumpmap				"models/weapons/tfa_bo3/wunderwaffe/i_wpn_t7_zmb_dg2_pipe_n"
	$phongexponenttexture	"models/weapons/tfa_bo3/wunderwaffe/i_wpn_t7_zmb_dg2_pipe_s"

	$phong	"1"
	$phongboost	"5"
	$phongfresnelranges	"[.78 .9 1]"

	$envmap	"env_cubemap"
	$envmaptint	"[.25 .25 .25]"
	$normalmapalphaenvmapmask	"1"
	$envmapfresnel	"1"
	
	$envmapmultiplier	"[.25 .25 .25]" // Lighting will be multiplied by this value
 
	Proxies
	{
		TFA_CubemapTint
		{
			resultvar	$envmaptint // Write final output to $envmaptint
			multiplier	$envmapmultiplier // Use our value for default envmap tint
		}
	}
}