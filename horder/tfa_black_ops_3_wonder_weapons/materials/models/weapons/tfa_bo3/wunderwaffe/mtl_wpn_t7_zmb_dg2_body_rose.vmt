"VertexLitGeneric"
{
	$basetexture			"models/weapons/tfa_bo3/wunderwaffe/i_wpn_t7_zmb_dg2_body_spc"
	$bumpmap				"models/weapons/tfa_bo3/wunderwaffe/i_wpn_t7_zmb_dg2_body_n"
	$phongexponenttexture	"models/weapons/tfa_bo3/wunderwaffe/i_wpn_t7_zmb_dg2_body_s"
	$color2 "[.25 .25 .25]"

	$phong	"1"
	$phongboost	"15"
	$phongfresnelranges	"[.78 .9 1]"
	$phongalbedotint "1"

	$envmap	"env_cubemap"
	$envmaptint	"{247 206 189}"
	$normalmapalphaenvmapmask	"1"
	$envmapfresnel	"1"
	
	$envmapmultiplier	"{247 206 189}" // Lighting will be multiplied by this value
 
	Proxies
	{
		TFA_CubemapTint
		{
			resultvar	$envmaptint // Write final output to $envmaptint
			multiplier	$envmapmultiplier // Use our value for default envmap tint
		}
	}
}