"VertexLitGeneric"
{
	$basetexture			"vgui/white"
	$bumpmap				"null-bumpmap"
	$phongexponenttexture	"vgui/white"
	$color2 "[.2 .2 .2]"
	$additive "1"

	$phong	"1"
	$phongboost	"5"
	$phongfresnelranges	"[.78 .9 1]"

	$envmap	"env_cubemap"
	$envmaptint	"[.25 .25 .25]"
	$normalmapalphaenvmapmask	"1"
	$envmapfresnel	"1"
	
	$envmapmultiplier	"[.25 .25 .25]" // Lighting will be multiplied by this value
 
	Proxies
	{
		TFA_CubemapTint
		{
			resultvar	$envmaptint // Write final output to $envmaptint
			multiplier	$envmapmultiplier // Use our value for default envmap tint
		}
	}
}